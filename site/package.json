{
  "name": "crashcourt-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "gen:schema": "node scripts/gen-schema.ts",
    "check:schema": "node scripts/gen-schema.ts --check",
    "guard": "node scripts/guard-verdicts.ts",
    "validate:artifacts": "node scripts/validate-artifacts.ts",
    "prebuild": "npm run check:schema && npm run guard && npm run validate:artifacts",
    "build": "next build",
    "postbuild": "node scripts/postbuild.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "node --test \"tests/unit/*.test.ts\"",
    "serve": "node scripts/serve.ts",
    "test:e2e": "playwright test",
    "measure": "node scripts/measure-bundles.ts",
    "size": "size-limit",
    "lighthouse": "node scripts/lighthouse.ts",
    "screenshots": "node scripts/screenshots.ts"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@radix-ui/react-tabs": "1.1.21",
    "@xyflow/react": "12.12.0",
    "d3-scale": "4.0.2",
    "d3-selection": "3.0.0",
    "d3-zoom": "3.0.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@jridgewell/trace-mapping": "0.3.31",
    "@playwright/test": "1.63.0",
    "@size-limit/file": "14.1.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/d3-scale": "4.0.9",
    "@types/d3-selection": "3.0.11",
    "@types/d3-zoom": "3.0.8",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "chrome-launcher": "1.2.1",
    "json-schema-to-typescript": "16.0.0",
    "lighthouse": "13.5.0",
    "prettier": "3.9.9",
    "size-limit": "14.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
