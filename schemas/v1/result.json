{
  "$defs": {
    "InvariantResult": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "enum": [
                  "EXPECTED",
                  "PASS",
                  "VIOLATION",
                  "VIOLATION_CANDIDATE"
                ]
              }
            },
            "required": [
              "outcome"
            ],
            "type": "object"
          },
          "then": {
            "properties": {
              "clause": {
                "type": "string"
              }
            },
            "required": [
              "clause"
            ],
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "enum": [
                  "GAP",
                  "NO_ANOMALY_UNSPECIFIED"
                ]
              }
            },
            "required": [
              "outcome"
            ],
            "type": "object"
          },
          "then": {
            "properties": {
              "clause": {
                "type": "null"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "enum": [
                  "EXPECTED",
                  "GAP",
                  "VIOLATION",
                  "VIOLATION_CANDIDATE"
                ]
              }
            },
            "required": [
              "outcome"
            ],
            "type": "object"
          },
          "then": {
            "properties": {
              "evidence": {
                "minItems": 1,
                "type": "array"
              }
            },
            "required": [
              "evidence"
            ],
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "enum": [
                  "VIOLATION"
                ]
              }
            },
            "required": [
              "outcome"
            ],
            "type": "object"
          },
          "then": {
            "properties": {
              "repro": {
                "type": "string"
              },
              "review": {
                "type": "object"
              }
            },
            "required": [
              "repro",
              "review"
            ],
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "enum": [
                  "INVALID",
                  "NO_ANOMALY_UNSPECIFIED",
                  "PASS"
                ]
              }
            },
            "required": [
              "outcome"
            ],
            "type": "object"
          },
          "then": {
            "properties": {
              "repro": {
                "type": "null"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "enum": [
                  "EXPECTED",
                  "GAP",
                  "INVALID",
                  "NO_ANOMALY_UNSPECIFIED",
                  "PASS",
                  "VIOLATION_CANDIDATE"
                ]
              }
            },
            "required": [
              "outcome"
            ],
            "type": "object"
          },
          "then": {
            "properties": {
              "review": {
                "type": "null"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "enum": [
                  "INVALID"
                ]
              }
            },
            "required": [
              "outcome"
            ],
            "type": "object"
          },
          "then": {
            "properties": {
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "reason"
            ],
            "type": "object"
          }
        }
      ],
      "description": "One invariant's outcome in one trial.\n\nEach outcome needs some of clause, evidence, repro, review, and reason; the table is in\ncrashcourt.spec.records, and the rules are under allOf here.",
      "properties": {
        "clause": {
          "anyOf": [
            {
              "pattern": "^\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clause"
        },
        "evidence": {
          "default": [],
          "items": {
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "invariant": {
          "pattern": "^\\S+$",
          "title": "Invariant",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "PASS",
            "VIOLATION",
            "EXPECTED",
            "GAP",
            "INVALID",
            "VIOLATION_CANDIDATE",
            "NO_ANOMALY_UNSPECIFIED"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "repro": {
          "anyOf": [
            {
              "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repro"
        },
        "review": {
          "anyOf": [
            {
              "$ref": "#/$defs/Review"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "invariant",
        "outcome"
      ],
      "title": "InvariantResult",
      "type": "object"
    },
    "Review": {
      "additionalProperties": false,
      "description": "The human review a VIOLATION requires.",
      "properties": {
        "reviewed": {
          "format": "date",
          "title": "Reviewed",
          "type": "string"
        },
        "reviewer": {
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
          "title": "Reviewer",
          "type": "string"
        }
      },
      "required": [
        "reviewer",
        "reviewed"
      ],
      "title": "Review",
      "type": "object"
    }
  },
  "$id": "urn:crashcourt:schema:v1:result",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "result.json: the outcomes of one trial, one per invariant.\n\nA fixture's batch id starts with DEMO-, and only a fixture's. Two rules are checked when\nrecords are loaded and are not in this JSON Schema: one outcome per invariant, and a\nmanifest hash equal to the batch's.",
  "else": {
    "properties": {
      "batch": {
        "not": {
          "pattern": "^DEMO-",
          "type": "string"
        }
      }
    },
    "type": "object"
  },
  "if": {
    "properties": {
      "provenance": {
        "const": "fixture"
      }
    },
    "required": [
      "provenance"
    ],
    "type": "object"
  },
  "properties": {
    "batch": {
      "pattern": "^\\S+$",
      "title": "Batch",
      "type": "string"
    },
    "cell": {
      "pattern": "^\\S+$",
      "title": "Cell",
      "type": "string"
    },
    "manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "provenance": {
      "enum": [
        "run",
        "fixture"
      ],
      "title": "Provenance",
      "type": "string"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/InvariantResult"
      },
      "minItems": 1,
      "title": "Results",
      "type": "array"
    },
    "trial": {
      "minimum": 0,
      "title": "Trial",
      "type": "integer"
    },
    "v": {
      "const": 1,
      "title": "V",
      "type": "integer"
    }
  },
  "required": [
    "v",
    "batch",
    "cell",
    "trial",
    "provenance",
    "manifest_sha256",
    "results"
  ],
  "then": {
    "properties": {
      "batch": {
        "pattern": "^DEMO-",
        "type": "string"
      }
    },
    "type": "object"
  },
  "title": "ResultRecord",
  "type": "object"
}
