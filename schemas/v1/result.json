{
  "$defs": {
    "InvariantResult": {
      "additionalProperties": false,
      "description": "One invariant's outcome in one trial.\n\nEach outcome needs some of clause, evidence, repro, review, and reason; the table is in\ncrashcourt.spec.records. Those rules are enforced when a record is loaded and are not\nexpressed in this JSON Schema.",
      "properties": {
        "clause": {
          "anyOf": [
            {
              "pattern": "^\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clause"
        },
        "evidence": {
          "default": [],
          "items": {
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "invariant": {
          "pattern": "^\\S+$",
          "title": "Invariant",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "PASS",
            "VIOLATION",
            "EXPECTED",
            "GAP",
            "INVALID",
            "VIOLATION_CANDIDATE",
            "NO_ANOMALY_UNSPECIFIED"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "repro": {
          "anyOf": [
            {
              "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repro"
        },
        "review": {
          "anyOf": [
            {
              "$ref": "#/$defs/Review"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "invariant",
        "outcome"
      ],
      "title": "InvariantResult",
      "type": "object"
    },
    "Review": {
      "additionalProperties": false,
      "description": "The human review a VIOLATION requires.",
      "properties": {
        "reviewed": {
          "format": "date",
          "title": "Reviewed",
          "type": "string"
        },
        "reviewer": {
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
          "title": "Reviewer",
          "type": "string"
        }
      },
      "required": [
        "reviewer",
        "reviewed"
      ],
      "title": "Review",
      "type": "object"
    }
  },
  "$id": "urn:crashcourt:schema:v1:result",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "result.json: the outcomes of one trial, one per invariant.\n\nA fixture's batch id starts with DEMO-, and only a fixture's. What each outcome needs is\nlisted in crashcourt.spec.records. Rules this JSON Schema does not express are enforced when\na record is loaded.",
  "properties": {
    "batch": {
      "pattern": "^\\S+$",
      "title": "Batch",
      "type": "string"
    },
    "cell": {
      "pattern": "^\\S+$",
      "title": "Cell",
      "type": "string"
    },
    "manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "provenance": {
      "enum": [
        "run",
        "fixture"
      ],
      "title": "Provenance",
      "type": "string"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/InvariantResult"
      },
      "minItems": 1,
      "title": "Results",
      "type": "array"
    },
    "trial": {
      "minimum": 0,
      "title": "Trial",
      "type": "integer"
    },
    "v": {
      "const": 1,
      "title": "V",
      "type": "integer"
    }
  },
  "required": [
    "v",
    "batch",
    "cell",
    "trial",
    "provenance",
    "manifest_sha256",
    "results"
  ],
  "title": "ResultRecord",
  "type": "object"
}
