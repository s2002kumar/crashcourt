{
  "$id": "urn:crashcourt:schema:v1:batch",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "batch.json: one batch, its provenance, and the manifest it ran under.\n\nA fixture's batch id starts with DEMO-, and only a fixture's.",
  "else": {
    "properties": {
      "batch": {
        "not": {
          "pattern": "^DEMO-",
          "type": "string"
        }
      }
    },
    "type": "object"
  },
  "if": {
    "properties": {
      "provenance": {
        "const": "fixture"
      }
    },
    "required": [
      "provenance"
    ],
    "type": "object"
  },
  "properties": {
    "batch": {
      "pattern": "^\\S+$",
      "title": "Batch",
      "type": "string"
    },
    "manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "provenance": {
      "enum": [
        "run",
        "fixture"
      ],
      "title": "Provenance",
      "type": "string"
    },
    "v": {
      "const": 1,
      "title": "V",
      "type": "integer"
    }
  },
  "required": [
    "v",
    "batch",
    "provenance",
    "manifest_sha256"
  ],
  "then": {
    "properties": {
      "batch": {
        "pattern": "^DEMO-",
        "type": "string"
      }
    },
    "type": "object"
  },
  "title": "BatchRecord",
  "type": "object"
}
